{
  "manifest_version": 3,
  "name": "NooBoss - Extension Manager",
  "version": "1.0.0",
  "description": "Manage Chrome extensions with groups, AutoState URL rules, and history tracking.",
  "permissions": [
    "management",
    "storage",
    "tabs",
    "notifications"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "NooBoss - Extension Manager"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "manager/manager.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}
